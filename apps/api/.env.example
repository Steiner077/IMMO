NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://immo:immo@localhost:5432/immo?schema=public
# Mindestens 32 zufällige Zeichen – in Produktion zwingend ändern!
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Kommagetrennte Liste erlaubter Frontends
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
# Automatisierungen (Sollstellungen, Mahnhinweise, Erinnerungen) im Hintergrund ausführen
AUTOMATION_ENABLED=true
LOG_LEVEL=info
LOGIN_RATE_LIMIT=10
